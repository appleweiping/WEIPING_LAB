ANTHROPIC_API_KEY=
OPENAI_API_KEY=                         # optional, for GPT models
DEEPSEEK_API_KEY=                       # optional, for DeepSeek screener
OPENROUTER_API_KEY=                     # optional, for OpenRouter models
SEMANTIC_SCHOLAR_API_KEY=               # optional, increases rate limits

WEIPING_LAB_WORKSPACE_ROOT=             # optional, defaults to ./workspace
AGENTMEMORY_URL=http://localhost:3111
WEIPING_LAB_ARCHITECT_MODEL=claude-opus-4-7
WEIPING_LAB_EXECUTOR_MODEL=claude-sonnet-4-6
WEIPING_LAB_AUDITOR_MODEL=claude-sonnet-4-6
WEIPING_LAB_SCREENER_MODEL=deepseek-chat

WEIPING_LAB_CONTEXT_FILE=               # optional, maintained project-context file
WEIPING_LAB_RULES_FILE=                 # optional, public-safe rules file
WEIPING_WIKI_ROOT=                      # optional, maintained wiki root

# Experiment evidence thresholds and the v1.0 JSON handoff are enforced by the project;
# see docs/RESULT_CONTRACT.md. They are intentionally not bypassable through environment flags.

# Legacy fallback names still work for existing workspaces:
# VIPIN_LAB_WORKSPACE_ROOT, VIPIN_LAB_ARCHITECT_MODEL, VIPIN_LAB_EXECUTOR_MODEL,
# VIPIN_LAB_AUDITOR_MODEL, VIPIN_LAB_SCREENER_MODEL, VIPIN_LAB_CONTEXT_FILE,
# VIPIN_LAB_RULES_FILE, VIPIN_WIKI_ROOT
